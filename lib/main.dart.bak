// =============================================================================
// ZULU BUTTONS
// Drone canister pump control panel
// Targets: Windows / Linux (incl. Raspberry Pi OS) / Android
// Talks to Pi at 192.168.8.2 (configurable)
// =============================================================================

import 'dart:convert';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:shared_preferences/shared_preferences.dart';

import 'services/commands.dart';
import 'services/udp_service.dart';
import 'services/event_log.dart';
import 'actuator_page.dart';

void main() {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const PuneApp());
}

// -----------------------------------------------------------------------------
// THEME TOKENS
// -----------------------------------------------------------------------------

const Color kBg = Color(0xFF0A0A0A); // near-black background
const Color kSurface = Color(0xFF161616); // card surface
const Color kSurface2 = Color(0xFF222222); // raised / input surface
const Color kBorder = Color(0xFF2A2A2A); // hairline border
const Color kAccent = Color(0xFFFFC72C); // industrial caution yellow
const Color kAccentDim = Color(0xFFB8901F); // dim accent
const Color kDanger = Color(0xFFFF5252);
const Color kSuccess = Color(0xFF4CAF50);
const Color kTextPrimary = Color(0xFFFFFFFF);
const Color kTextDim = Color(0xFF888888);

const String kMono = 'monospace';

// -----------------------------------------------------------------------------
// APP ROOT
// -----------------------------------------------------------------------------

class PuneApp extends StatelessWidget {
  const PuneApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Zulu Buttons',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor: kBg,
        canvasColor: kSurface,
        colorScheme: const ColorScheme.dark(
          primary: kAccent,
          secondary: kAccent,
          surface: kSurface,
          onPrimary: Colors.black,
          onSurface: kTextPrimary,
        ),
        appBarTheme: const AppBarTheme(
          backgroundColor: kBg,
          foregroundColor: kAccent,
          elevation: 0,
          centerTitle: false,
        ),
        sliderTheme: const SliderThemeData(
          activeTrackColor: kAccent,
          inactiveTrackColor: kSurface2,
          thumbColor: kAccent,
          trackHeight: 6,
        ),
      ),
      home: const HomePage(),
    );
  }
}

// =============================================================================
// MODELS
// =============================================================================

class PumpButton {
  String id;
  String label;
  String endpoint; // UDP command string (e.g. "2")
  int port; // UDP destination port (3000 or 9000)
  bool isToggle;
  String toggleOffEndpoint;
  bool locked;

  PumpButton({
    required this.id,
    required this.label,
    this.endpoint = '',
    this.port = 3000,
    this.isToggle = false,
    this.toggleOffEndpoint = '',
    this.locked = false,
  });

  Map<String, dynamic> toJson() => {
    'id': id,
    'label': label,
    'endpoint': endpoint,
    'port': port,
    'isToggle': isToggle,
    'toggleOffEndpoint': toggleOffEndpoint,
    'locked': locked,
  };

  factory PumpButton.fromJson(Map<String, dynamic> j) => PumpButton(
    id: j['id'] ?? DateTime.now().millisecondsSinceEpoch.toString(),
    label: j['label'] ?? 'Button',
    endpoint: j['endpoint'] ?? '',
    port: j['port'] ?? 3000,
    isToggle: j['isToggle'] ?? false,
    toggleOffEndpoint: j['toggleOffEndpoint'] ?? '',
    locked: j['locked'] ?? false,
  );
}

class AppConfig {
  String piHost;
  int piPort;
  String pressureEndpoint;
  double pressureMin;
  double pressureMax;

  AppConfig({
    this.piHost = '192.168.8.2',
    this.piPort = 80,
    this.pressureEndpoint = '/pressure',
    this.pressureMin = 0,
    this.pressureMax = 150,
  });

  Map<String, dynamic> toJson() => {
    'piHost': piHost,
    'piPort': piPort,
    'pressureEndpoint': pressureEndpoint,
    'pressureMin': pressureMin,
    'pressureMax': pressureMax,
  };

  factory AppConfig.fromJson(Map<String, dynamic> j) => AppConfig(
    piHost: j['piHost'] ?? '192.168.8.2',
    piPort: j['piPort'] ?? 80,
    pressureEndpoint: j['pressureEndpoint'] ?? '/pressure',
    pressureMin: (j['pressureMin'] ?? 0).toDouble(),
    pressureMax: (j['pressureMax'] ?? 150).toDouble(),
  );
}

// =============================================================================
// STORAGE
// =============================================================================

class Storage {
  static const _kButtons = 'pump_buttons_v11';
  static const _kConfig = 'app_config_v1';

  static Future<List<PumpButton>> loadButtons() async {
    final prefs = await SharedPreferences.getInstance();
    final raw = prefs.getString(_kButtons);
    if (raw == null) return _defaultButtons();
    try {
      final List list = jsonDecode(raw);
      return list.map((e) => PumpButton.fromJson(e)).toList();
    } catch (_) {
      return _defaultButtons();
    }
  }

  static Future<void> saveButtons(List<PumpButton> btns) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(
      _kButtons,
      jsonEncode(btns.map((b) => b.toJson()).toList()),
    );
  }

  static Future<AppConfig> loadConfig() async {
    final prefs = await SharedPreferences.getInstance();
    final raw = prefs.getString(_kConfig);
    if (raw == null) return AppConfig();
    try {
      return AppConfig.fromJson(jsonDecode(raw));
    } catch (_) {
      return AppConfig();
    }
  }

  static Future<void> saveConfig(AppConfig c) async {
    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_kConfig, jsonEncode(c.toJson()));
  }

  static List<PumpButton> _defaultButtons() => [
    PumpButton(
      id: 'pump_start',
      label: 'PUMP START',
      endpoint: '0x05',
      port: 9000,
      isToggle: true,
      locked: true,
    ),
    PumpButton(
      id: 'pump_toggle',
      label: 'PUMP POWER',
      endpoint: '0x06',
      port: 9000,
      isToggle: true,
      locked: true,
    ),
    PumpButton(
      id: 'canister_1',
      label: 'CANISTER 1',
      endpoint: Cmd.canister1,
      port: Cmd.port,
      locked: true,
    ),
    PumpButton(
      id: 'canister_2',
      label: 'CANISTER 2',
      endpoint: Cmd.canister2,
      port: Cmd.port,
      locked: true,
    ),
  ];
}

// =============================================================================
// HOME PAGE
// =============================================================================

class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  List<PumpButton> _buttons = [];
  AppConfig _config = AppConfig();
  bool _loading = true;
  double _pressure = 80.0;
  final Set<String> _activeToggles = {};

  // 0 = "2 CANISTER" (this screen's own pump/canister controls)
  // 1 = "9 CANISTER" (the Linear Actuator Control screen)
  int _selectedProject = 0;

  @override
  void initState() {
    super.initState();
    _bootstrap();
  }

  Future<void> _bootstrap() async {
    final buttons = await Storage.loadButtons();
    final config = await Storage.loadConfig();
    if (!mounted) return;
    setState(() {
      _buttons = buttons;
      _config = config;
      _pressure = 80.0;
      _loading = false;
    });
  }

  @override
  void dispose() {
    super.dispose();
  }

  // ---------------- actions ----------------

  void _onButtonTap(PumpButton btn) {
    HapticFeedback.lightImpact();

    // raw-byte path (pump → port 9000, matches joystick_sender.cpp)
    if (btn.endpoint.startsWith('0x')) {
      final byte = int.tryParse(btn.endpoint.substring(2), radix: 16);
      if (byte == null) return;
      if (btn.isToggle) {
        final turningOn = !_activeToggles.contains(btn.id);
        UdpService.sendByte(byte, port: btn.port);
        setState(() {
          if (turningOn) {
            _activeToggles.add(btn.id);
          } else {
            _activeToggles.remove(btn.id);
          }
        });
        _showSnack(
          '${btn.label} → ${turningOn ? 'ON' : 'OFF'}',
          turningOn ? kSuccess : kAccentDim,
        );
       EventLog.log(
          '${btn.label} turned ${turningOn ? 'ON' : 'OFF'}',
          channel: EventLog.channelTwoCanister,
          binary: 'byte 0x${byte.toRadixString(16).padLeft(2, '0')} → ${_config.piHost}:${btn.port}',
        );
      } else {
        UdpService.sendByte(byte, port: btn.port);
        _showSnack('${btn.label} → ${btn.endpoint}', kSuccess);
        EventLog.log(
          '${btn.label} triggered',
          channel: EventLog.channelTwoCanister,
          binary: 'byte 0x${byte.toRadixString(16).padLeft(2, '0')} → ${_config.piHost}:${btn.port}',
        );
      }
      return;
    }

    // ASCII path (canisters → port 3000) — unchanged
    if (btn.isToggle) {
      final turningOn = !_activeToggles.contains(btn.id);
      final cmd = (!turningOn && btn.toggleOffEndpoint.isNotEmpty)
          ? btn.toggleOffEndpoint
          : btn.endpoint;
      if (cmd.isNotEmpty) UdpService.send(cmd, port: btn.port);
      setState(() {
        if (turningOn) {
          _activeToggles.add(btn.id);
        } else {
          _activeToggles.remove(btn.id);
        }
      });
      _showSnack(
        '${btn.label} → ${turningOn ? 'ON' : 'OFF'}',
        turningOn ? kSuccess : kAccentDim,
      );
    EventLog.log(
        '${btn.label} turned ${turningOn ? 'ON' : 'OFF'}',
        channel: EventLog.channelTwoCanister,
        binary: "cmd '$cmd' → ${_config.piHost}:${btn.port}",
      );
      return;
    }
    if (btn.endpoint.isEmpty) return;
   UdpService.send(btn.endpoint, port: btn.port);
    _showSnack('${btn.label} → ${btn.endpoint}', kSuccess);
    EventLog.log(
      '${btn.label} triggered',
      channel: EventLog.channelTwoCanister,
      binary: "cmd '${btn.endpoint}' → ${_config.piHost}:${btn.port}",
    );
  }

  Future<void> _editButton(PumpButton? btn) async {
    if (btn != null && btn.locked) return;
    final result = await showDialog<PumpButton>(
      context: context,
      builder: (_) => EditButtonDialog(button: btn),
    );
    if (result == null) return;
    setState(() {
      if (btn == null) {
        _buttons.add(result);
      } else {
        final idx = _buttons.indexWhere((b) => b.id == btn.id);
        if (idx >= 0) _buttons[idx] = result;
      }
    });
    await Storage.saveButtons(_buttons);
  }

  Future<void> _deleteButton(PumpButton btn) async {
    if (btn.locked) return;
    final confirm = await showDialog<bool>(
      context: context,
      builder: (_) => AlertDialog(
        backgroundColor: kSurface,
        title: const Text(
          'DELETE BUTTON',
          style: TextStyle(color: kAccent, letterSpacing: 2, fontSize: 16),
        ),
        content: Text(
          'Remove "${btn.label}" ?',
          style: const TextStyle(color: kTextDim),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text(
              'CANCEL',
              style: TextStyle(color: kTextDim, letterSpacing: 1),
            ),
          ),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            child: const Text(
              'DELETE',
              style: TextStyle(
                color: kDanger,
                letterSpacing: 1,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),
        ],
      ),
    );
    if (confirm == true) {
      setState(() {
        _buttons.removeWhere((b) => b.id == btn.id);
        _activeToggles.remove(btn.id);
      });
      await Storage.saveButtons(_buttons);
    }
  }

  Future<void> _openSettings() async {
    final result = await showDialog<AppConfig>(
      context: context,
      builder: (_) => SettingsDialog(config: _config),
    );
    if (result != null) {
      setState(() => _config = result);
      await Storage.saveConfig(result);
    }
  }

  Future<void> _openButtonManager() async {
    await showModalBottomSheet<void>(
      context: context,
      backgroundColor: kSurface,
      isScrollControlled: true,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(12)),
      ),
      builder: (ctx) => DraggableScrollableSheet(
        initialChildSize: 0.6,
        minChildSize: 0.3,
        maxChildSize: 0.9,
        expand: false,
        builder: (_, scrollCtrl) => Column(
          children: [
            Container(
              margin: const EdgeInsets.symmetric(vertical: 10),
              width: 40,
              height: 4,
              decoration: BoxDecoration(
                color: kBorder,
                borderRadius: BorderRadius.circular(2),
              ),
            ),
            Padding(
              padding: const EdgeInsets.fromLTRB(16, 0, 16, 8),
              child: Row(
                children: [
                  const Text(
                    'EDIT BUTTONS',
                    style: TextStyle(
                      color: kAccent,
                      fontWeight: FontWeight.w900,
                      letterSpacing: 3,
                      fontSize: 13,
                    ),
                  ),
                  const Spacer(),
                  TextButton.icon(
                    onPressed: () async {
                      Navigator.pop(ctx);
                      await _editButton(null);
                    },
                    icon: const Icon(Icons.add, color: kAccent, size: 16),
                    label: const Text(
                      'NEW',
                      style: TextStyle(
                        color: kAccent,
                        letterSpacing: 2,
                        fontSize: 12,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                  ),
                ],
              ),
            ),
            const Divider(color: kBorder, height: 1),
            Expanded(
              child: _buttons.isEmpty
                  ? const Center(
                      child: Text(
                        'NO BUTTONS YET',
                        style: TextStyle(color: kTextDim, letterSpacing: 2),
                      ),
                    )
                  : ListView.separated(
                      controller: scrollCtrl,
                      itemCount: _buttons.length,
                      separatorBuilder: (_, __) =>
                          const Divider(color: kBorder, height: 1),
                      itemBuilder: (_, i) {
                        final btn = _buttons[i];
                        return ListTile(
                          title: Text(
                            btn.label,
                            style: const TextStyle(
                              color: kTextPrimary,
                              fontWeight: FontWeight.w700,
                              letterSpacing: 1,
                            ),
                          ),
                          subtitle: Text(
                            'CMD: ${btn.endpoint}',
                            style: const TextStyle(
                              color: kTextDim,
                              fontFamily: kMono,
                              fontSize: 11,
                            ),
                          ),
                          trailing: btn.locked
                              ? const Icon(
                                  Icons.lock_outline,
                                  color: kTextDim,
                                  size: 18,
                                )
                              : Row(
                                  mainAxisSize: MainAxisSize.min,
                                  children: [
                                    IconButton(
                                      icon: const Icon(
                                        Icons.edit,
                                        color: kAccent,
                                        size: 18,
                                      ),
                                      onPressed: () async {
                                        Navigator.pop(ctx);
                                        await _editButton(btn);
                                      },
                                    ),
                                    IconButton(
                                      icon: const Icon(
                                        Icons.delete_outline,
                                        color: kDanger,
                                        size: 18,
                                      ),
                                      onPressed: () async {
                                        Navigator.pop(ctx);
                                        await _deleteButton(btn);
                                      },
                                    ),
                                  ],
                                ),
                        );
                      },
                    ),
            ),
          ],
        ),
      ),
    );
  }

  Future<void> _setPressure() async {
    // Intentionally NOT firing the HTTP request — pressure control is
    // not wired up yet. UI lives, transport is parked.
    HapticFeedback.mediumImpact();
    if (!mounted) return;
    _showSnack(
      'PRESSURE  ${_pressure.toStringAsFixed(0)} PSI  ·  NOT WIRED UP',
      kAccentDim,
    );
    EventLog.log('Pressure reading updated: ${_pressure.toStringAsFixed(0)} PSI → :${_config.piPort}', channel: EventLog.channelTwoCanister);
  }

  Future<void> _openPressureDialog() async {
    final pressureController = TextEditingController(
      text: _pressure.toStringAsFixed(0),
    );

    await showDialog<void>(
      context: context,
      builder: (_) => StatefulBuilder(
        builder: (ctx, setLocal) => Dialog(
          backgroundColor: kSurface,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
          ),
          child: ConstrainedBox(
            constraints: const BoxConstraints(maxWidth: 460),
            child: Padding(
              padding: const EdgeInsets.fromLTRB(20, 18, 20, 16),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  Row(
                    children: [
                      const Icon(
                        Icons.speed_outlined,
                        color: kAccent,
                        size: 18,
                      ),
                      const SizedBox(width: 8),
                      const Text(
                        'PRESSURE',
                        style: TextStyle(
                          color: kAccent,
                          fontWeight: FontWeight.w900,
                          letterSpacing: 3,
                          fontSize: 13,
                        ),
                      ),
                      const Spacer(),
                      Container(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 6,
                          vertical: 2,
                        ),
                        decoration: BoxDecoration(
                          color: kAccentDim.withOpacity(0.15),
                          borderRadius: BorderRadius.circular(3),
                          border: Border.all(color: kAccentDim, width: 1),
                        ),
                        child: const Text(
                          'PARKED',
                          style: TextStyle(
                            color: kAccentDim,
                            fontSize: 9,
                            fontWeight: FontWeight.w900,
                            letterSpacing: 2,
                          ),
                        ),
                      ),
                      IconButton(
                        icon: const Icon(
                          Icons.close,
                          color: kTextDim,
                          size: 18,
                        ),
                        onPressed: () => Navigator.pop(ctx),
                        padding: EdgeInsets.zero,
                        constraints: const BoxConstraints(),
                      ),
                    ],
                  ),
                  const SizedBox(height: 18),
                  Row(
                    crossAxisAlignment: CrossAxisAlignment.end,
                    children: [
                      Text(
                        _pressure.toStringAsFixed(0),
                        style: const TextStyle(
                          color: kTextPrimary,
                          fontSize: 48,
                          fontFamily: kMono,
                          fontWeight: FontWeight.w900,
                          height: 1,
                        ),
                      ),
                      const SizedBox(width: 6),
                      const Padding(
                        padding: EdgeInsets.only(bottom: 6),
                        child: Text(
                          'PSI',
                          style: TextStyle(
                            color: kTextDim,
                            fontSize: 13,
                            letterSpacing: 2,
                            fontWeight: FontWeight.bold,
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),
                  TextField(
                    controller: pressureController,
                    textAlign: TextAlign.center,
                    keyboardType: TextInputType.number,
                    maxLength: 3,
                    inputFormatters: [
                      FilteringTextInputFormatter.digitsOnly,
                      LengthLimitingTextInputFormatter(3),
                    ],
                    style: const TextStyle(
                      color: kTextPrimary,
                      fontFamily: kMono,
                      fontSize: 16,
                    ),
                    decoration: InputDecoration(
                      counterText: '', // hide the built-in "x/3" counter
                      hintText: 'Enter pressure (max 999)',
                      hintStyle: const TextStyle(color: kTextDim, fontSize: 12),
                      filled: true,
                      fillColor: kSurface2,
                      contentPadding: const EdgeInsets.symmetric(
                        horizontal: 12,
                        vertical: 10,
                      ),
                      enabledBorder: OutlineInputBorder(
                        borderSide: const BorderSide(color: kBorder),
                        borderRadius: BorderRadius.circular(6),
                      ),
                      focusedBorder: OutlineInputBorder(
                        borderSide: const BorderSide(color: kAccent, width: 1.5),
                        borderRadius: BorderRadius.circular(6),
                      ),
                    ),
                    onChanged: (text) {
                      final parsed = int.tryParse(text);
                      if (parsed == null) return;
                      // Clamp to the configured min/max AND hard-cap at 999
                      // (3 digits) regardless of what pressureMax is set to.
                      final capped = parsed.clamp(
                        _config.pressureMin.toInt(),
                        _config.pressureMax.toInt().clamp(0, 999),
                      );
                      setLocal(() {});
                      setState(() => _pressure = capped.toDouble());
                    },
                  ),
                  const SizedBox(height: 8),
                  Slider(
                    value: _pressure.clamp(
                      _config.pressureMin,
                      _config.pressureMax,
                    ),
                    min: _config.pressureMin,
                    max: _config.pressureMax,
                    divisions: (_config.pressureMax - _config.pressureMin)
                        .toInt(),
                    onChanged: (v) {
                      setLocal(() {
                        pressureController.text = v.toStringAsFixed(0);
                      });
                      setState(() => _pressure = v);
                    },
                  ),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Text(
                        _config.pressureMin.toStringAsFixed(0),
                        style: const TextStyle(
                          color: kTextDim,
                          fontFamily: kMono,
                          fontSize: 11,
                        ),
                      ),
                      Text(
                        _config.pressureMax.toStringAsFixed(0),
                        style: const TextStyle(
                          color: kTextDim,
                          fontFamily: kMono,
                          fontSize: 11,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 14),
                  SizedBox(
                    width: double.infinity,
                    child: ElevatedButton(
                      onPressed: () {
                        _setPressure();
                        Navigator.pop(ctx);
                      },
                      style: ElevatedButton.styleFrom(
                        backgroundColor: kAccent,
                        foregroundColor: Colors.black,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(6),
                        ),
                      ),
                      child: const Text(
                        'SET PRESSURE',
                        style: TextStyle(
                          fontWeight: FontWeight.w900,
                          letterSpacing: 3,
                        ),
                      ),
                    ),
                  ),
                  const SizedBox(height: 6),
                  const Text(
                    'Pressure transport is parked — UI only.',
                    textAlign: TextAlign.center,
                    style: TextStyle(
                      color: kTextDim,
                      fontSize: 10,
                      letterSpacing: 1,
                      fontFamily: kMono,
                    ),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }

  void _showSnack(String msg, Color color) {
    final messenger = ScaffoldMessenger.of(context);
    messenger.clearSnackBars();
    messenger.showSnackBar(
      SnackBar(
        content: Text(
          msg,
          style: const TextStyle(
            color: kTextPrimary,
            fontFamily: kMono,
            fontSize: 13,
          ),
        ),
        backgroundColor: color.withOpacity(0.92),
        duration: const Duration(seconds: 2),
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(6)),
      ),
    );
  }

  // ---------------- build ----------------

  @override
  Widget build(BuildContext context) {
    if (_loading) {
      return const Scaffold(
        body: Center(child: CircularProgressIndicator(color: kAccent)),
      );
    }
    return Scaffold(
      // No Scaffold-level AppBar — using a custom top bar instead (see
      // _buildTopBar) so it only sits above the content column, not above
      // the sidebar. This lets the sidebar reach all the way to the top
      // of the window with no empty strip above it.
      body: Stack(
        children: [
          Row(
            children: [
              _buildSidebar(),
              Expanded(
                child: Column(
                  children: [
                    _buildTopBar(),
                    Expanded(
                      child: _selectedProject == 0
                          ? _buildTwoCanisterBody()
                          : const ActuatorControlPage(embedded: true),
                    ),
                  ],
                ),
              ),
            ],
          ),
          Positioned(
            right: 16,
            bottom: 16,
            child: _EventLogPanel(
              key: ValueKey(_selectedProject), // fresh state per project
              channel: _selectedProject == 0
                  ? EventLog.channelTwoCanister
                  : EventLog.channelNineCanister,
              piHost: _config.piHost,
              // 2 CANISTER uses both :9000 (pump, raw byte) and :3000
              // (canisters, ASCII). 9 CANISTER uses :3000 for everything
              // (see Cmd.port in services/commands.dart).
              portsLabel: _selectedProject == 0
                  ? ':9000 · :3000'
                  : ':${Cmd.port}',
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildTopBar() {
    return Container(
      height: 56,
      padding: const EdgeInsets.symmetric(horizontal: 8),
      decoration: const BoxDecoration(
        color: kBg,
        border: Border(bottom: BorderSide(color: kBorder)),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.end,
        children: _selectedProject == 0
            ? [
                _UdpBadge(onTap: _openSettings),
                IconButton(
                  icon: const Icon(Icons.edit_outlined),
