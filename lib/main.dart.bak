      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 6, 16, 8),
            child: Row(
              children: [
                Image.asset(
                  'assets/zulu_button.png',
                  width: 24,
                  height: 24,
                  filterQuality: FilterQuality.medium,
                  errorBuilder: (_, _, _) => const _HazardChip(),
                ),
                const SizedBox(width: 8),
                const Expanded(
                  child: Text(
                    'ZULU BUTTONS',
                    style: TextStyle(
                      color: kAccent,
                      fontWeight: FontWeight.w900,
                      letterSpacing: 2,
                      fontSize: 13,
                    ),
                  ),
                ),
              ],
            ),
          ),
          const Divider(color: kBorder, height: 1),
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 10, 16, 8),
            child: Text(
              'PROJECTS',
              style: TextStyle(
                color: kTextDim,
                fontWeight: FontWeight.w900,
                letterSpacing: 2,
                fontSize: 11,
              ),
            ),
          ),
          _buildSidebarItem(
            index: 0,
            icon: Icons.grid_view_rounded,
            label: '2 CANISTER',
          ),
          const SizedBox(height: 6),
          _buildSidebarItem(
            index: 1,
            icon: Icons.tune,
            label: '9 CANISTER',
          ),
          const Spacer(),
          const Divider(color: kBorder, height: 1),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
            child: InkWell(
              onTap: _openSettings,
              borderRadius: BorderRadius.circular(8),
              child: Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 12,
                  vertical: 12,
                ),
                child: const Row(
                  children: [
                    Icon(Icons.settings_outlined, size: 18, color: kTextDim),
                    SizedBox(width: 10),
                    Text(
                      'SETTINGS',
                      style: TextStyle(
                        color: kTextPrimary,
                        fontWeight: FontWeight.w800,
                        letterSpacing: 1,
                        fontSize: 12,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
          const Padding(
            padding: EdgeInsets.fromLTRB(12, 0, 12, 12),
            child: Text(
              'v0.2',
              style: TextStyle(
                color: kTextDim,
                fontSize: 10,
                fontFamily: kMono,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildSidebarItem({
    required int index,
    required IconData icon,
    required String label,
  }) {
    final selected = _selectedProject == index;
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 12),
      child: InkWell(
        onTap: () => setState(() => _selectedProject = index),
        borderRadius: BorderRadius.circular(8),
        child: Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
          decoration: BoxDecoration(
            color: selected ? kAccent.withOpacity(0.14) : Colors.transparent,
            borderRadius: BorderRadius.circular(8),
            border: Border.all(
              color: selected ? kAccent : Colors.transparent,
              width: 1.2,
            ),
          ),
          child: Row(
            children: [
              Icon(
                icon,
                size: 18,
                color: selected ? kAccent : kTextDim,
              ),
              const SizedBox(width: 10),
              Text(
                label,
                style: TextStyle(
                  color: selected ? kAccent : kTextPrimary,
                  fontWeight: FontWeight.w800,
                  letterSpacing: 1,
                  fontSize: 12,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _buildTwoCanisterBody() {
    return SafeArea(
      child: LayoutBuilder(
        builder: (context, constraints) {
          return SingleChildScrollView(
            padding: const EdgeInsets.all(16),
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 980),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  _SectionHeader(label: 'CONTROLS', count: _buttons.length),
                  const SizedBox(height: 12),
                  _buildButtonGrid(constraints.maxWidth),
                  const SizedBox(height: 12),
                  _buildAddButton(),
                  const SizedBox(height: 24),
                  _buildFooter(),
                ],
              ),
            ),
          );
        },
      ),
    );
  }

  Widget _buildButtonGrid(double maxWidth) {
    if (_buttons.isEmpty) {
      return _Panel(
        child: const Padding(
          padding: EdgeInsets.symmetric(vertical: 24),
          child: Center(
            child: Text(
              'NO BUTTONS YET — TAP "+ ADD BUTTON" TO CREATE ONE',
              style: TextStyle(color: kTextDim, letterSpacing: 1, fontSize: 12),
              textAlign: TextAlign.center,
            ),
          ),
        ),
      );
    }
    final cols = maxWidth > 880
        ? 4
        : maxWidth > 600
        ? 3
        : 2;
    return GridView.builder(
      shrinkWrap: true,
      physics: const NeverScrollableScrollPhysics(),
      gridDelegate: SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: cols,
        childAspectRatio: 1.25,
        mainAxisSpacing: 10,
        crossAxisSpacing: 10,
      ),
      itemCount: _buttons.length,
      itemBuilder: (_, i) {
        final btn = _buttons[i];
        return _PumpButtonTile(
          button: btn,
          isActive: _activeToggles.contains(btn.id),
          onTap: () => _onButtonTap(btn),
          onEdit: () => _editButton(btn),
          onDelete: () => _deleteButton(btn),
        );
      },
    );
  }

  Widget _buildAddButton() {
    return InkWell(
      onTap: () => _editButton(null),
      borderRadius: BorderRadius.circular(8),
      child: Container(
        padding: const EdgeInsets.symmetric(vertical: 14),
        decoration: BoxDecoration(
          color: Colors.transparent,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(color: kAccent, width: 1.5),
        ),
        child: const Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Icon(Icons.add, color: kAccent, size: 20),
            SizedBox(width: 8),
            Text(
              'ADD BUTTON',
              style: TextStyle(
                color: kAccent,
                fontWeight: FontWeight.w900,
                letterSpacing: 3,
                fontSize: 13,
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _buildFooter() {
    return Center(
      child: Text(
        'ZULU BUTTONS  ·  v0.2  ·  UDP :3000',
        style: const TextStyle(
          color: kTextDim,
          fontSize: 10,
          letterSpacing: 2,
          fontFamily: kMono,
        ),
      ),
    );
  }
}

