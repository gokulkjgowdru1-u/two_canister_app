                ),
                const SizedBox(width: 4),
              ]
            : [_UdpBadge(onTap: _openSettings), const SizedBox(width: 4)],
      ),
    );
  }

  Widget _buildSidebar() {
    return Container(
      width: 220,
      decoration: const BoxDecoration(
        color: kSurface,
