// EDIT BUTTON DIALOG
// =============================================================================

class EditButtonDialog extends StatefulWidget {
  final PumpButton? button;
  const EditButtonDialog({super.key, this.button});

  @override
  State<EditButtonDialog> createState() => _EditButtonDialogState();
}

class _EditButtonDialogState extends State<EditButtonDialog> {
  late TextEditingController _label;
  late TextEditingController _endpoint;
  late TextEditingController _offEndpoint;
  int _port = 3000;
  bool _isToggle = false;

  @override
  void initState() {
    super.initState();
    final b = widget.button;
    _label = TextEditingController(text: b?.label ?? '');
    _endpoint = TextEditingController(text: b?.endpoint ?? '');
    _offEndpoint = TextEditingController(text: b?.toggleOffEndpoint ?? '');
    _port = b?.port ?? 3000;
    _isToggle = b?.isToggle ?? false;
  }

  @override
  void dispose() {
    _label.dispose();
    _endpoint.dispose();
    _offEndpoint.dispose();
    super.dispose();
  }

  InputDecoration _dec(String label) => InputDecoration(
    labelText: label,
    labelStyle: const TextStyle(
      color: kTextDim,
      fontSize: 11,
      letterSpacing: 2,
      fontWeight: FontWeight.bold,
    ),
    filled: true,
    fillColor: kSurface2,
    enabledBorder: OutlineInputBorder(
      borderSide: const BorderSide(color: kBorder),
      borderRadius: BorderRadius.circular(6),
    ),
    focusedBorder: OutlineInputBorder(
      borderSide: const BorderSide(color: kAccent, width: 1.5),
      borderRadius: BorderRadius.circular(6),
    ),
    contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 14),
  );

  @override
  Widget build(BuildContext context) {
    final isNew = widget.button == null;
    return AlertDialog(
      backgroundColor: kSurface,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
      title: Text(
        isNew ? 'NEW BUTTON' : 'EDIT BUTTON',
        style: const TextStyle(
          color: kAccent,
          letterSpacing: 3,
          fontSize: 14,
          fontWeight: FontWeight.w900,
        ),
      ),
      content: SizedBox(
        width: 420,
        child: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              TextField(
                controller: _label,
                style: const TextStyle(color: kTextPrimary),
                decoration: _dec('LABEL'),
              ),
              const SizedBox(height: 12),
              TextField(
                controller: _endpoint,
                style: const TextStyle(color: kTextPrimary, fontFamily: kMono),
                decoration: _dec('UDP COMMAND  (e.g. 2, 3, 0)'),
              ),
              const SizedBox(height: 12),
              DropdownButtonFormField<int>(
                value: _port,
                dropdownColor: kSurface2,
                style: const TextStyle(color: kTextPrimary),
                decoration: _dec('UDP PORT'),
                items: const [
                  DropdownMenuItem(
                    value: 3000,
                    child: Text(':3000  →  all commands (udp_gpio)'),
                  ),
                  DropdownMenuItem(
                    value: 9000,
                    child: Text(':9000  →  alternate port'),
                  ),
                ],
                onChanged: (v) => setState(() => _port = v ?? 3000),
              ),
              const SizedBox(height: 8),
              Container(
                decoration: BoxDecoration(
                  border: Border.all(color: kBorder),
                  borderRadius: BorderRadius.circular(6),
                ),
                child: SwitchListTile(
                  title: const Text(
                    'TOGGLE MODE',
                    style: TextStyle(
                      color: kTextPrimary,
                      letterSpacing: 1.5,
                      fontWeight: FontWeight.w900,
                      fontSize: 12,
                    ),
                  ),
                  subtitle: const Text(
                    'Tap toggles ON / OFF',
                    style: TextStyle(color: kTextDim, fontSize: 11),
                  ),
                  value: _isToggle,
                  activeColor: kAccent,
                  onChanged: (v) => setState(() => _isToggle = v),
                ),
              ),
              if (_isToggle) ...[
                const SizedBox(height: 12),
                TextField(
                  controller: _offEndpoint,
                  style: const TextStyle(
                    color: kTextPrimary,
                    fontFamily: kMono,
                  ),
                  decoration: _dec('UDP OFF COMMAND  (e.g. 2, 3)'),
                ),
              ],
            ],
          ),
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text(
            'CANCEL',
            style: TextStyle(color: kTextDim, letterSpacing: 2),
          ),
        ),
        ElevatedButton(
          onPressed: () {
            if (_label.text.trim().isEmpty) return;
            final btn = PumpButton(
              id:
                  widget.button?.id ??
                  DateTime.now().millisecondsSinceEpoch.toString(),
              label: _label.text.trim(),
              endpoint: _endpoint.text.trim(),
              port: _port,
              isToggle: _isToggle,
              toggleOffEndpoint: _isToggle ? _offEndpoint.text.trim() : '',
              locked: widget.button?.locked ?? false,
            );
            Navigator.pop(context, btn);
          },
          style: ElevatedButton.styleFrom(
            backgroundColor: kAccent,
            foregroundColor: Colors.black,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(6),
            ),
          ),
          child: const Text(
            'SAVE',
            style: TextStyle(fontWeight: FontWeight.w900, letterSpacing: 2),
          ),
        ),
      ],
    );
  }
}

// =============================================================================
// SETTINGS DIALOG
// =============================================================================

class SettingsDialog extends StatefulWidget {
  final AppConfig config;
  const SettingsDialog({super.key, required this.config});

  @override
  State<SettingsDialog> createState() => _SettingsDialogState();
}

class _SettingsDialogState extends State<SettingsDialog> {
  late TextEditingController _host;
  late TextEditingController _port;
  late TextEditingController _pressureEp;
  late TextEditingController _pMin;
  late TextEditingController _pMax;

  @override
  void initState() {
    super.initState();
    _host = TextEditingController(text: widget.config.piHost);
    _port = TextEditingController(text: widget.config.piPort.toString());
    _pressureEp = TextEditingController(text: widget.config.pressureEndpoint);
    _pMin = TextEditingController(
      text: widget.config.pressureMin.toStringAsFixed(0),
    );
    _pMax = TextEditingController(
      text: widget.config.pressureMax.toStringAsFixed(0),
    );
  }

  @override
  void dispose() {
    _host.dispose();
    _port.dispose();
    _pressureEp.dispose();
    _pMin.dispose();
    _pMax.dispose();
    super.dispose();
  }

  InputDecoration _dec(String label) => InputDecoration(
    labelText: label,
    labelStyle: const TextStyle(
      color: kTextDim,
      fontSize: 11,
      letterSpacing: 2,
      fontWeight: FontWeight.bold,
    ),
    filled: true,
    fillColor: kSurface2,
    enabledBorder: OutlineInputBorder(
      borderSide: const BorderSide(color: kBorder),
      borderRadius: BorderRadius.circular(6),
    ),
    focusedBorder: OutlineInputBorder(
      borderSide: const BorderSide(color: kAccent, width: 1.5),
      borderRadius: BorderRadius.circular(6),
    ),
    contentPadding: const EdgeInsets.symmetric(horizontal: 12, vertical: 14),
  );

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      backgroundColor: kSurface,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
      title: const Text(
        'SETTINGS',
        style: TextStyle(
          color: kAccent,
          letterSpacing: 3,
          fontSize: 14,
          fontWeight: FontWeight.w900,
        ),
      ),
      content: SizedBox(
        width: 420,
        child: SingleChildScrollView(
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              const Text(
                'CONNECTION',
                style: TextStyle(
                  color: kTextDim,
                  fontSize: 10,
                  letterSpacing: 2,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 8),
              TextField(
                controller: _host,
                style: const TextStyle(color: kTextPrimary, fontFamily: kMono),
                decoration: _dec('PI HOST  (e.g. 192.168.8.2)'),
              ),
              const SizedBox(height: 10),
              TextField(
                controller: _port,
                keyboardType: TextInputType.number,
                style: const TextStyle(color: kTextPrimary, fontFamily: kMono),
                decoration: _dec('PORT'),
              ),
              const SizedBox(height: 18),
              const Text(
                'PRESSURE',
                style: TextStyle(
                  color: kTextDim,
                  fontSize: 10,
                  letterSpacing: 2,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 8),
              TextField(
                controller: _pressureEp,
                style: const TextStyle(color: kTextPrimary, fontFamily: kMono),
                decoration: _dec('ENDPOINT'),
              ),
              const SizedBox(height: 10),
              Row(
                children: [
                  Expanded(
                    child: TextField(
                      controller: _pMin,
                      keyboardType: TextInputType.number,
                      maxLength: 3,
                      inputFormatters: [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(3),
                      ],
                      style: const TextStyle(
                        color: kTextPrimary,
                        fontFamily: kMono,
                      ),
                      decoration: _dec('MIN PSI').copyWith(counterText: ''),
                    ),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: TextField(
                      controller: _pMax,
                      keyboardType: TextInputType.number,
                      maxLength: 3,
                      inputFormatters: [
                        FilteringTextInputFormatter.digitsOnly,
                        LengthLimitingTextInputFormatter(3),
                      ],
                      style: const TextStyle(
                        color: kTextPrimary,
                        fontFamily: kMono,
                      ),
                      decoration: _dec('MAX PSI').copyWith(counterText: ''),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text(
            'CANCEL',
            style: TextStyle(color: kTextDim, letterSpacing: 2),
          ),
        ),
        ElevatedButton(
          onPressed: () {         
            final cfg = AppConfig(
              piHost: _host.text.trim().isEmpty
                  ? '192.168.8.2'
                  : _host.text.trim(),
              piPort: int.tryParse(_port.text.trim()) ?? 80,
              pressureEndpoint: _pressureEp.text.trim().isEmpty
                  ? '/pressure'
                  : _pressureEp.text.trim(),
              pressureMin: (double.tryParse(_pMin.text.trim()) ?? 0).clamp(
                0,
                999,
              ),
              pressureMax: (double.tryParse(_pMax.text.trim()) ?? 150).clamp(
                0,
                999,
              ),
            );
            Navigator.pop(context, cfg);
          },
          style: ElevatedButton.styleFrom(
            backgroundColor: kAccent,
            foregroundColor: Colors.black,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(6),
            ),
          ),
          child: const Text(
            'SAVE',
            style: TextStyle(fontWeight: FontWeight.w900, letterSpacing: 2),
          ),
        ),
      ],
    );
  }
}
