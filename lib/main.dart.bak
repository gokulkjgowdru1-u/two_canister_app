/// Diagonal yellow/black hazard-stripe chip used as a brand mark next to title.
class _HazardChip extends StatelessWidget {
  const _HazardChip();
  @override
  Widget build(BuildContext context) {
    return Container(
      width: 22,
      height: 22,
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(4),
        border: Border.all(color: kAccent, width: 1.5),
      ),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(3),
        child: CustomPaint(painter: _HazardPainter()),
      ),
    );
  }
}

class _HazardPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paintYellow = Paint()..color = kAccent;
    final paintBlack = Paint()..color = Colors.black;
    canvas.drawRect(Offset.zero & size, paintBlack);
    final w = size.width, h = size.height;
    final stride = 6.0;
    for (double x = -h; x < w + h; x += stride * 2) {
      final p = Path()
        ..moveTo(x, 0)
        ..lineTo(x + stride, 0)
        ..lineTo(x + stride + h, h)
        ..lineTo(x + h, h)
        ..close();
      canvas.drawPath(p, paintYellow);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

/// Small floating "LIVE EVENT LOG" panel, anchored to the bottom-right
/// corner. Listens to EventLog.entries and updates automatically —
/// works no matter which screen (2 CANISTER or 9 CANISTER) logged
/// the event.
class _EventLogPanel extends StatefulWidget {
  final String channel;
  final String piHost;
  final String portsLabel; // e.g. ":9000 · :3000"
  const _EventLogPanel({
    super.key,
    required this.channel,
    required this.piHost,
    required this.portsLabel,
  });

  @override
  State<_EventLogPanel> createState() => _EventLogPanelState();
}

class _EventLogPanelState extends State<_EventLogPanel> {
  bool _expanded = false;
  bool _live = true;
  int _logTab = 0; // 0 = LIVE LOG (plain English), 1 = BINARY LOG (technical)
  List<LogEntry>? _frozenSnapshot; // captured when paused

  void _toggleLive(List<LogEntry> currentEntries) {
    setState(() {
      if (_live) {
        _frozenSnapshot = List<LogEntry>.from(currentEntries);
      } else {
        // Resuming — drop the snapshot, go back to live data.
        _frozenSnapshot = null;
      }
      _live = !_live;
    });
  }

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<List<LogEntry>>(
      valueListenable: EventLog.entriesFor(widget.channel),
      builder: (context, liveEntries, _) {
        final entries = _live ? liveEntries : (_frozenSnapshot ?? liveEntries);

        // Collapsed: last 8, newest at the bottom (original behavior).
        // Expanded: everything, newest at the bottom, panel just grows
        // upward into the empty space above it instead of opening a
        // separate popup.
        final visible = _expanded
            ? entries
            : (entries.length > 8
                  ? entries.sublist(entries.length - 8)
                  : entries);
        return AnimatedContainer(
          duration: const Duration(milliseconds: 180),
          width: 340,
          constraints: BoxConstraints(
            maxHeight: _expanded ? 560 : 280,
          ),
          decoration: BoxDecoration(
            color: kSurface.withOpacity(0.96),
            borderRadius: BorderRadius.circular(8),
            border: Border.all(color: kBorder),
            boxShadow: const [
              BoxShadow(
                color: Colors.black45,
                blurRadius: 12,
                offset: Offset(0, 4),
              ),
            ],
          ),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Padding(
                padding: const EdgeInsets.fromLTRB(12, 10, 8, 8),
                child: Row(
                  children: [
                    _LogTabButton(
                      label: 'LIVE LOG',
                      selected: _logTab == 0,
                      onTap: () => setState(() => _logTab = 0),
                    ),
                    const SizedBox(width: 6),
                    _LogTabButton(
                      label: 'BINARY LOG',
                      selected: _logTab == 1,
                      onTap: () => setState(() => _logTab = 1),
                    ),
                    if (_expanded) ...[
                      const SizedBox(width: 6),
                      Text(
                        '[${entries.length}]',
                        style: const TextStyle(
                          color: kTextDim,
                          fontSize: 10,
                          fontFamily: kMono,
                        ),
                      ),
                    ],
                    const Spacer(),
                    // LIVE / PAUSED pill toggle
                    InkWell(
                      onTap: () => _toggleLive(liveEntries),
                      borderRadius: BorderRadius.circular(20),
                      child: Container(
                        margin: const EdgeInsets.only(right: 4),
                        padding: const EdgeInsets.symmetric(
                          horizontal: 8,
                          vertical: 3,
                        ),
                        decoration: BoxDecoration(
                          color: (_live ? kSuccess : kTextDim).withOpacity(
                            0.15,
                          ),
                          borderRadius: BorderRadius.circular(20),
                          border: Border.all(
                            color: _live ? kSuccess : kTextDim,
                            width: 1,
                          ),
                        ),
                        child: Row(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Container(
                              width: 6,
                              height: 6,
                              decoration: BoxDecoration(
                                shape: BoxShape.circle,
                                color: _live ? kSuccess : kTextDim,
                              ),
                            ),
                            const SizedBox(width: 4),
                            Text(
                              _live ? 'LIVE' : 'PAUSED',
                              style: TextStyle(
                                color: _live ? kSuccess : kTextDim,
                                fontSize: 9,
                                fontWeight: FontWeight.w900,
                                letterSpacing: 1,
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                    InkWell(
                      onTap: () => setState(() => _expanded = !_expanded),
                      borderRadius: BorderRadius.circular(4),
                      child: Padding(
                        padding: const EdgeInsets.all(4),
                        child: Icon(
                          _expanded
                              ? Icons.close_fullscreen
                              : Icons.open_in_full,
                          color: kTextDim,
                          size: 14,
                        ),
                      ),
                    ),
                    InkWell(
                      onTap: entries.isEmpty
                          ? null
                          : () => EventLog.clear(widget.channel),
                      borderRadius: BorderRadius.circular(4),
                      child: Padding(
                        padding: const EdgeInsets.all(4),
                        child: Icon(
                          Icons.delete_outline,
                          color: entries.isEmpty ? kBorder : kDanger,
                          size: 14,
                        ),
                      ),
                    ),
                  ],
                ),
              ),
              // Connection info line — host + ports in use for this project.
              Padding(
                padding: const EdgeInsets.fromLTRB(12, 0, 12, 8),
                child: Row(
                  children: [
                    const Icon(Icons.dns_outlined, color: kTextDim, size: 11),
                    const SizedBox(width: 4),
                    Expanded(
                      child: Text(
                        '${widget.piHost}  ·  ${widget.portsLabel}',
                        style: const TextStyle(
                          color: kTextDim,
                          fontSize: 10,
                          fontFamily: kMono,
                        ),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                  ],
                ),
              ),
              const Divider(color: kBorder, height: 1),
              Flexible(
                child: visible.isEmpty
                    ? const Padding(
                        padding: EdgeInsets.all(12),
                        child: Text(
                          'No events yet',
                          style: TextStyle(color: kTextDim, fontSize: 11),
                        ),
                      )
                    : ListView.builder(
                        padding: const EdgeInsets.symmetric(
                          horizontal: 12,
                          vertical: 8,
                        ),
                        shrinkWrap: true,
                        itemCount: visible.length,
                        itemBuilder: (_, i) => Padding(
                          padding: const EdgeInsets.only(bottom: 4),
                          child: Text(
                            _logTab == 0 ? visible[i].human : visible[i].binary,
                            style: const TextStyle(
                              color: kTextDim,
                              fontSize: 11,
                              fontFamily: kMono,
                            ),
                          ),
                        ),
                      ),
              ),
            ],
          ),
        );
      },
    );
  }
}
