/// Individual pump button tile.
/// Tap → fires endpoint.  Long-press → edit / delete menu.
class _PumpButtonTile extends StatefulWidget {
  final PumpButton button;
  final bool isActive;
  final VoidCallback onTap;
  final VoidCallback onEdit;
  final VoidCallback onDelete;

  const _PumpButtonTile({
    required this.button,
    required this.isActive,
    required this.onTap,
    required this.onEdit,
    required this.onDelete,
  });

  @override
  State<_PumpButtonTile> createState() => _PumpButtonTileState();
}

class _PumpButtonTileState extends State<_PumpButtonTile>
    with SingleTickerProviderStateMixin {
  bool _pressed = false;
  late final AnimationController _flashCtrl;

  @override
  void initState() {
    super.initState();
    _flashCtrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 180),
    );
  }

  @override
  void dispose() {
    _flashCtrl.dispose();
    super.dispose();
  }

  void _setPressed(bool p) {
    if (mounted && _pressed != p) setState(() => _pressed = p);
  }

  void _handleTap() {
    HapticFeedback.selectionClick();
    _flashCtrl.forward(from: 0).then((_) => _flashCtrl.reverse());
    widget.onTap();
  }

  @override
  Widget build(BuildContext context) {
    final btn = widget.button;
    final isActive = widget.isActive;
    return GestureDetector(
      onTapDown: (_) => _setPressed(true),
      onTapUp: (_) => _setPressed(false),
      onTapCancel: () => _setPressed(false),
      onTap: _handleTap,
      onLongPress: () => _showMenu(context),
      child: AnimatedScale(
        scale: _pressed ? 0.94 : 1.0,
        duration: const Duration(milliseconds: 90),
        curve: Curves.easeOut,
        child: AnimatedBuilder(
          animation: _flashCtrl,
          builder: (context, child) {
            final flash = _flashCtrl.value;
            final baseColor = kSurface;
            // Press / flash darkens-then-brightens for tactile feel
            final pressedColor =
                Color.lerp(kSurface, kAccent.withOpacity(0.18), flash)!;
            return AnimatedContainer(
              duration: const Duration(milliseconds: 140),
              decoration: BoxDecoration(
                color: _pressed ? pressedColor : baseColor,
                borderRadius: BorderRadius.circular(10),
                border: Border.all(
                  color: (_pressed || flash > 0 ? kAccent : kBorder),
                  width: 1,
                ),
                boxShadow: (flash > 0
                    ? [
                        BoxShadow(
                          color: kAccent.withOpacity(0.35 * flash),
                          blurRadius: 14,
                          spreadRadius: 0,
                        ),
                      ]
                    : null),
              ),
              child: child,
            );
          },
          child: Padding(
            padding: const EdgeInsets.all(10),
            child: Stack(
              children: [
                Center(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                     
                      Text(
                        btn.label.toUpperCase(),
                        textAlign: TextAlign.center,
                        maxLines: 2,
                        overflow: TextOverflow.ellipsis,
                        style: TextStyle(
                          color: kTextPrimary,
                          fontWeight: FontWeight.w900,
                          fontSize: 15,
                          letterSpacing: 1.5,
                        ),
                      ),
                      if (btn.endpoint.isNotEmpty) ...[
                        const SizedBox(height: 4),
                        Text(
                          btn.endpoint,
                          textAlign: TextAlign.center,
                          overflow: TextOverflow.ellipsis,
                          style: TextStyle(
                            color: kTextDim,
                            fontSize: 10,
                            fontFamily: kMono,
                          ),
                        ),
                      ],
                    ],
                  ),
                ),
                Positioned(
                  top: 0,
                  right: 0,
                  child: Text(
                    ':${btn.port}',
                    style: TextStyle(
                      color: kTextDim,
                      fontSize: 9,
                      fontFamily: kMono,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  void _showMenu(BuildContext context) {
    showModalBottomSheet(
      context: context,
      backgroundColor: kSurface,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(12)),
      ),
      builder: (_) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              margin: const EdgeInsets.symmetric(vertical: 8),
              width: 40,
              height: 4,
              decoration: BoxDecoration(
                color: kBorder,
                borderRadius: BorderRadius.circular(2),
              ),
            ),
            if (widget.button.locked)
              ListTile(
                leading: const Icon(Icons.lock_outline, color: kTextDim),
                title: const Text(
                  'CORE CONTROL — LOCKED',
                  style: TextStyle(color: kTextDim, letterSpacing: 1),
                ),
              )
            else ...[
              ListTile(
                leading: const Icon(Icons.edit, color: kAccent),
                title: Text(
                  'Edit "${widget.button.label}"',
                  style: const TextStyle(color: kTextPrimary),
                ),
                onTap: () {
                  Navigator.pop(context);
                  widget.onEdit();
                },
              ),
              ListTile(
                leading: const Icon(Icons.delete_outline, color: kDanger),
                title: const Text('Delete', style: TextStyle(color: kDanger)),
                onTap: () {
                  Navigator.pop(context);
                  widget.onDelete();
                },
              ),
            ],
            const SizedBox(height: 8),
          ],
        ),
      ),
    );
  }
}

